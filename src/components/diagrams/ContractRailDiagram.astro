---
// ContractRail's example, from the repo README (sections 4 and 6): the UI may only
// import the frozen interface. "Apply the violation patch" adds the forbidden
// import and shows the gate results the README reports for it.
const gates = [
  { id: "typecheck", label: "Typecheck", breaks: false },
  { id: "lint", label: "Lint", breaks: true },
  { id: "tests", label: "Tests", breaks: false },
  { id: "arch", label: "Architecture test", breaks: true },
];
---
<figure class="d-figure cr" data-contractrail data-tilt-zone>
  <div data-tilt>
    <svg class="d-svg" viewBox="0 0 460 320" role="img" aria-labelledby="cr-title">
      <title id="cr-title">
        Dependency rules: the UI imports only the repository interface; the data source implements
        it. A direct import from the UI to the data source is not allowed.
      </title>

      <path class="d-line" d="M140 66 V122" />
      <path class="d-fill-ink" d="M140 122 l-5 -9 h10 z" />
      <text class="d-note" x="150" y="98">imports only the interface</text>

      <path class="d-line" d="M140 250 V194" />
      <path class="d-fill-ink" d="M140 194 l-5 9 h10 z" />
      <text class="d-note" x="150" y="226">implements it</text>

      {/* The forbidden edge, drawn only while the patch is applied */}
      <g class="violation" data-violation>
        <path class="d-line edge" d="M250 40 H360 V276 H262" />
        <path class="d-fill-ink" d="M262 276 l9 -5 v10 z" />
        <g class="cross">
          <circle cx="360" cy="158" r="13" />
          <path d="M354 152 l12 12 m0 -12 l-12 12" />
        </g>
        <text class="d-note-strong" x="380" y="154">direct</text>
        <text class="d-note-strong" x="380" y="170">import</text>
      </g>

      <g class="d-node">
        <rect class="d-base" x="30" y="14" width="220" height="52" />
        <g class="d-face">
          <rect class="d-box" x="30" y="14" width="220" height="52" />
          <text class="d-label" x="140" y="37" text-anchor="middle">UI</text>
          <text class="d-note" x="140" y="54" text-anchor="middle">src/ui/</text>
        </g>
      </g>

      <g class="d-node is-on">
        <rect class="d-base" x="30" y="132" width="220" height="52" />
        <g class="d-face">
          <rect class="d-box" x="30" y="132" width="220" height="52" />
          <text class="d-label" x="140" y="155" text-anchor="middle">Repository interface</text>
          <text class="d-note" x="140" y="172" text-anchor="middle">frozen, SHA-256 locked</text>
        </g>
      </g>

      <g class="d-node">
        <rect class="d-base" x="30" y="250" width="220" height="52" />
        <g class="d-face">
          <rect class="d-box" x="30" y="250" width="220" height="52" />
          <text class="d-label" x="140" y="273" text-anchor="middle">Data source</text>
          <text class="d-note" x="140" y="290" text-anchor="middle">src/data/</text>
        </g>
      </g>
    </svg>
  </div>

  <div class="panel">
    <ul class="gates" role="list" aria-label="Gate results">
      {gates.map((gate) => (
        <li class="gate" data-gate data-breaks={gate.breaks ? "true" : "false"}>
          <span class="mark" aria-hidden="true"></span>
          <span class="gate-label">{gate.label}</span>
          <span class="visually-hidden" data-gate-state>passes</span>
        </li>
      ))}
    </ul>
    <p class="message" data-message hidden>
      Lint: <q>CR-0001 rule 1: this layer may not import src/data.</q> The architecture test fails
      too, even with ESLint disabled.
    </p>
    <button class="toggle" type="button" aria-pressed="false" data-patch hidden>Apply the violation patch</button>
  </div>
  <figcaption class="d-caption">Fig. 3: the dependency rule from the README's example, and what the gates report</figcaption>
</figure>

<style>
  .violation {
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease);
  }

  .violation .edge {
    stroke-width: var(--line-heavy);
    stroke-dasharray: 6 4;
  }

  .cross circle {
    fill: var(--color-paper);
    stroke: var(--color-ink);
    stroke-width: var(--line-regular);
  }

  .cross path {
    stroke: var(--color-ink);
    stroke-width: var(--line-heavy);
  }

  .cr.is-violated .violation {
    opacity: 1;
  }

  .panel {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: var(--line-hair) solid var(--color-rule);
  }

  .gates {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .gate {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border: var(--line-regular) solid var(--color-accent);
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: var(--text-small);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-ui);
    transition:
      border-color var(--duration-fast) var(--ease),
      color var(--duration-fast) var(--ease),
      transform var(--duration-slow) var(--ease-spring);
  }

  .mark::before {
    content: "✓";
  }

  .gate.is-red {
    border-color: var(--color-ink);
    border-style: dashed;
    color: var(--color-ink);
    transform: translateY(calc(var(--lift) * -1));
  }

  .gate.is-red .mark::before {
    content: "✕";
  }

  .message {
    margin-top: var(--space-3);
    font-size: var(--text-small);
  }

  .toggle {
    margin-top: var(--space-4);
    padding: var(--space-2) var(--space-3);
    border: var(--line-regular) solid var(--color-ink);
    border-radius: var(--radius);
    background: var(--color-ink);
    color: var(--color-paper);
    font-family: var(--font-display);
    font-size: var(--text-small);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-ui);
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease), transform var(--duration-slow) var(--ease-spring);
  }

  .toggle:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .toggle:active {
    transform: translateY(var(--line-heavy));
  }

  .toggle[hidden] {
    display: none;
  }
</style>

<script>
  import { inspect } from "../../scripts/inspect";

  for (const figure of document.querySelectorAll<HTMLElement>("[data-contractrail]")) {
    const button = figure.querySelector<HTMLButtonElement>("[data-patch]");
    const message = figure.querySelector<HTMLElement>("[data-message]");
    if (!button) continue;
    button.hidden = false;

    button.addEventListener("click", () => {
      const violated = button.getAttribute("aria-pressed") !== "true";
      button.setAttribute("aria-pressed", String(violated));
      button.textContent = violated ? "Revert the patch" : "Apply the violation patch";
      figure.classList.toggle("is-violated", violated);
      if (violated) inspect("patch");
      if (message) message.hidden = !violated;
      for (const gate of figure.querySelectorAll<HTMLElement>("[data-gate]")) {
        const red = violated && gate.dataset.breaks === "true";
        gate.classList.toggle("is-red", red);
        const state = gate.querySelector("[data-gate-state]");
        if (state) state.textContent = red ? "fails" : "passes";
      }
    });
  }
</script>
